{
  "name": "@thezzisu/droidnode",
  "version": "0.140.0",
  "description": "Node-side launcher for Factory's droid CLI. Runs the droid JS bundle under a separately-installed Bun to sidestep the Bun 1.3.x standalone-init NULL allocator race that crashes `droid --resume` on long sessions.",
  "type": "module",
  "bin": {
    "droidnode": "bin/droidnode.js"
  },
  "files": [
    "bin/",
    "lib/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "droid": "0.140.0",
    "bun": "^1.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thezzisu/droidnode.git"
  },
  "bugs": {
    "url": "https://github.com/thezzisu/droidnode/issues"
  },
  "homepage": "https://github.com/thezzisu/droidnode#readme",
  "keywords": [
    "droid",
    "factory",
    "factory-ai",
    "bun",
    "workaround",
    "shim",
    "cli"
  ],
  "author": "thezzisu",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
